# The scratchpad root (default /private/tmp/claude-<uid>). Several roots: separate with ':'.
# SESSION_TAIL_ROOTS=/private/tmp/claude-502
# The transcript root (default ~/.claude/projects).
# SESSION_TAIL_TRANSCRIPTS=/Users/me/.claude/projects
# The local store (default ./store.sqlite in the checkout, ~/.config/session-tail/store.sqlite installed).
# SESSION_TAIL_STORE=./store.sqlite
# The dev server port (default 3459).
# SESSION_TAIL_PORT=3459
